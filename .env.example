# Copy this file to .env and fill in your actual values.
# .env is gitignored and never committed.

# Every host:port clients use to reach this server must be listed, or
# FastMCP's DNS-rebinding check rejects the request before it is handled.
# Comma-separated. Examples:
#   LAN only:               MCP_ALLOWED_HOSTS=myhost:8765,192.168.1.60:8765
#   LAN + Tailscale:        MCP_ALLOWED_HOSTS=myhost:8765,192.168.1.60:8765,100.x.x.x:8765
MCP_ALLOWED_HOSTS=

# Base URL used to build download_url links returned by MCP tools.
# Without this, download_url fields will be null (tools still work via doc_id).
MCP_PUBLIC_URL=

# Bearer token for the /files upload/download endpoints.
# Leave empty to leave the store open (only on a trusted LAN).
# Generate with: openssl rand -hex 24
MCP_UPLOAD_TOKEN=
